---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog Técnico B2B">
  <main class="max-w-6xl mx-auto px-6 py-16">
    {/* Se preserva tu cabecera original perfectamente centrada */}
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">Ingeniería y Casos de Éxito</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Conocimiento técnico, análisis comparativos y estrategias de mitigación de riesgos en sistemas de bombeo inteligente.
      </p>
    </header>

    {/* Contenedor donde Soro IA renderizará el catálogo de entradas y los artículos individuales */}
    <div id="soro-blog" style="min-height: 850px;"></div>
  </main>

  {/* Script oficial de Soro con directivas de compatibilidad para Astro y Netlify */}
  <script is:inline data-astro-rerun src="https://app.trysoro.com/api/embed/a1708a32-f931-40d2-84ab-1e9632686afc" defer></script>
</Layout>